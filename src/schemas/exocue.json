{
  "$id": "https://hop.io/schemas/exocue.json",
  "type": "object",
  "allOf": [
    { "$ref": "https://hop.io/schemas/base-contract.json" },
    {
      "properties": {
        "refcontract": {
          "const": "exocue"
        },
        "concept": {
          "type": "object",
          "properties": {
            "cue": { "type": "string" }
          }
        },
        "computational": {
          "type": "object",
          "properties": {
            "organelles": {
              "type": "object",
              "properties": {
                "orgo": { "type": "array", "items": { "type": "string" } },
                "gelle": { "type": "array", "items": { "type": "string" } }
              },
              "required": ["orgo", "gelle"]
            }
          },
          "required": ["components"]
        }
      }
    }
  ]
}